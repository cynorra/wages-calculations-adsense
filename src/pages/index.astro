---
import Base from "../layouts/Base.astro";
import { SITE, AUTHOR } from "../site.config.js";
import { TOOLS } from "../lib/tools.js";
import { liveArticles } from "../lib/articles-source.js";
import HourlySalaryMatrixTable from "../components/HourlySalaryMatrixTable.astro";

const articles = await liveArticles();
const featuredLead = articles[0];
const secondaryFeatured = articles.slice(1, 4);
const editorialColumns = articles.slice(4, 16);

// Format date helper: "Oct 23, 2026"
function formatDate(iso: string) {
  if (!iso) return "";
  const d = new Date(iso);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
---

<Base
  title={`${SITE.name} — Wage Economics & Labor Law Analysis`}
  description={SITE.description}
>
  <!-- Newspaper / Journal Header Strip -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
      <div class="flex items-center gap-3">
        <span class="font-medium text-slate-900">Volume IV</span>
        <span class="text-slate-300">/</span>
        <span>Independent Workplace Economics</span>
        <span class="text-slate-300">/</span>
        <span>Updated Daily</span>
      </div>
      <div class="flex items-center gap-4 text-slate-600">
        <a href="/methodology/" class="hover:text-slate-900 underline underline-offset-2">FLSA Standards</a>
        <a href="/about/" class="hover:text-slate-900 underline underline-offset-2">Editorial Board</a>
        <a href="/calculators/" class="hover:text-slate-900 underline underline-offset-2">Tools Index</a>
      </div>
    </div>
  </div>

  <!-- Editorial Masthead Headline -->
  <section class="border-b border-slate-200 bg-white py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">
          Labor Market Insights & Statutory Audits
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-slate-950 leading-[1.12] tracking-tight">
          How American compensation actually works—from statutory law to your paycheck.
        </h1>
        <p class="mt-5 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-3xl font-normal">
          An open-formula research publication breaking down Title 29 Fair Labor Standards Act provisions, IRS withholding tables, overtime arithmetic, and multi-state wage mechanics.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Front Page Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Top Editorial Section (Lead Story + 3 Column Sidebar) -->
    <section class="pb-14 border-b border-slate-200">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        
        <!-- Big Lead Story (7 cols) -->
        {featuredLead && (
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2.5 text-xs text-slate-500 mb-3">
                <span class="uppercase tracking-wider font-semibold text-slate-900">Cover Story</span>
                <span>&bull;</span>
                <time datetime={featuredLead.published_at}>{formatDate(featuredLead.published_at)}</time>
                <span>&bull;</span>
                <span>By Eren Şimşir</span>
              </div>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-slate-950 leading-snug hover:text-brand-700 transition-colors">
                <a href={`/guides/${featuredLead.slug}/`}>
                  {featuredLead.title}
                </a>
              </h2>
              <p class="mt-5 text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
                {featuredLead.description}
              </p>
            </div>
            
            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/guides/${featuredLead.slug}/`}
                class="text-sm font-semibold text-slate-900 hover:text-brand-700 inline-flex items-center gap-1.5 underline underline-offset-4"
              >
                Read Full Report &rarr;
              </a>
              <span class="text-xs text-slate-400">10-12 min read</span>
            </div>
          </div>
        )}

        <!-- 3 Secondary Articles Stacked (5 cols) -->
        <div class="lg:col-span-5 border-t lg:border-t-0 lg:border-l border-slate-200 pt-8 lg:pt-0 lg:pl-10 space-y-8">
          <div class="text-xs font-semibold uppercase tracking-widest text-slate-400">
            Current Analyses
          </div>
          {secondaryFeatured.map((item: any) => (
            <article class="group">
              <div class="flex items-center gap-2 text-xs text-slate-500 mb-1.5">
                <span>{formatDate(item.published_at)}</span>
                <span>&bull;</span>
                <span class="text-slate-700 font-medium">Workplace Law</span>
              </div>
              <h3 class="text-lg sm:text-xl font-serif font-bold text-slate-950 leading-snug group-hover:text-brand-700 transition-colors">
                <a href={`/guides/${item.slug}/`}>
                  {item.title}
                </a>
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed">
                {item.description}
              </p>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- Broad Editorial Grid (9-12 Articles in Crisp Editorial Cards) -->
    <section class="py-14 border-b border-slate-200">
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">Recent Reports & Guides</h2>
          <p class="text-xs text-slate-500 mt-1">Explanations of overtime regulations, tax withholding models, and compensation benchmarks.</p>
        </div>
        <a href="/guides/" class="text-xs font-semibold text-slate-900 hover:underline">
          View All {articles.length} &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
        {editorialColumns.map((guide: any) => (
          <article class="flex flex-col justify-between group pt-2">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>{formatDate(guide.published_at)}</span>
                <span class="text-slate-600 text-[11px] font-medium">Labor Economics</span>
              </div>
              <h3 class="text-lg font-serif font-bold text-slate-950 group-hover:text-brand-700 transition-colors leading-snug">
                <a href={`/guides/${guide.slug}/`}>
                  {guide.title}
                </a>
              </h3>
              <p class="mt-2.5 text-xs text-slate-600 line-clamp-3 leading-relaxed">
                {guide.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <a href={`/guides/${guide.slug}/`} class="font-medium text-slate-900 hover:underline">
                Read Analysis &rarr;
              </a>
              <span class="text-slate-400">By Eren Şimşir</span>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href="/guides/"
          class="inline-flex items-center px-6 py-2.5 border border-slate-300 text-xs font-semibold uppercase tracking-wider text-slate-900 bg-white hover:bg-slate-50 transition-colors"
        >
          Browse Complete Article Archive &rarr;
        </a>
      </div>
    </section>

    <!-- Editor & Methodology Note (Authentic E-E-A-T) -->
    <section class="py-14 border-b border-slate-200">
      <div class="bg-stone-50 border border-slate-200 p-8 sm:p-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-8">
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">About This Publication</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950 mt-1">Edited by {AUTHOR.name}</h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed font-normal">
              {AUTHOR.shortBio}
            </p>
            <p class="mt-3 text-xs text-slate-500 leading-relaxed">
              Every formula published on this site references statutory primary sources: Title 29 of the Code of Federal Regulations, U.S. Department of Labor Wage and Hour Division bulletins, and IRS Publication 15-T employer withholding methods.
            </p>
          </div>
          <div class="md:col-span-4 flex flex-col gap-3 md:border-l md:border-slate-200 md:pl-8">
            <a
              href={`/author/${AUTHOR.slug}/`}
              class="text-xs font-semibold text-slate-900 hover:underline inline-flex items-center gap-1"
            >
              Author Bio & Academic Background &rarr;
            </a>
            <a
              href="/methodology/"
              class="text-xs font-semibold text-slate-900 hover:underline inline-flex items-center gap-1"
            >
              Mathematical Methodology & FLSA Rules &rarr;
            </a>
            <a
              href="/editorial-policy/"
              class="text-xs font-semibold text-slate-900 hover:underline inline-flex items-center gap-1"
            >
              Fact-Checking & Editorial Policy &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Reference Data & Companion Tools (Pure Editorial & Static) -->
    <section class="py-14">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Reference Tables & Tools</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950 mt-1">Wage Conversion Benchmarks</h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Standard statutory gross compensation matrices computed under Title 29 FLSA benchmarks (40-hour workweek, 2,080 annual base hours).
        </p>
      </div>

      <!-- Static Reference Table (Pure HTML / No Interactive Forms) -->
      <div class="mb-10">
        <HourlySalaryMatrixTable />
      </div>

      <!-- Editorial Tooling Banner Card -->
      <div class="bg-stone-50 border border-slate-200 p-8 rounded-lg mb-12 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Interactive Directory</span>
          <h3 class="text-xl font-serif font-bold text-slate-900 mt-1">Need customized payroll or overtime calculations?</h3>
          <p class="text-xs text-slate-600 mt-1.5 max-w-xl">
            Audit non-standard schedules, shift differentials, multi-state tax exemptions, and bonus allocations with our standalone calculation tools.
          </p>
        </div>
        <a
          href="/calculators/"
          class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-slate-900 hover:bg-slate-800 transition-colors shrink-0"
        >
          View All 25 Calculators &rarr;
        </a>
      </div>



      <!-- Minimal Tools Index List -->
      <div class="border-t border-slate-200 pt-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-700">All Calculation Tools Index</h3>
          <a href="/calculators/" class="text-xs text-slate-900 underline font-medium">Directory View &rarr;</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 text-xs">
          {TOOLS.map((t) => (
            <a
              href={t.href}
              class="text-slate-600 hover:text-slate-950 py-1 transition-colors truncate block"
              title={t.name}
            >
              &bull; {t.shortName}
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>
</Base>

