---
import Base from "../../layouts/Base.astro";
import { liveArticles } from "../../lib/articles-source.js";
import { guideRow } from "../../lib/frontmatter.js";
import { articleSchema, breadcrumbSchema } from "../../lib/schema.js";
import { articleKind, KIND_LABEL, readingMinutes } from "../../lib/article-kind.js";
import { coverSvg } from "../../lib/cover-art.js";
import { marked } from "marked";
import katex from "katex";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const articles = await liveArticles();
  return articles.map((article: any) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const kind = articleKind(article.slug);
const kindLabel = KIND_LABEL[kind];
// The auto-injected link list duplicates the related cards below, so it is not rendered in the body.
const bodyMd = article.body_md.replace(/\n## Related Statutory & Payroll Guides[\s\S]*$/, "").trim();
const minutes = readingMinutes(bodyMd);
const cover = coverSvg(article.slug, kind, { label: `Illustration for ${article.title}`, className: "w-full h-full" });
const headline = (article.description.match(/\$\d[\d,]*\.\d{2}(?:\s*(?:per hour|\/hr|per week|per month))?/) || [])[0];

// Related guides: same layout family first, then the rest, neighbours in publication order
const liveGuides = await liveArticles();
const liveSlugs = new Set(liveGuides.map((g: any) => g.slug));
const others = liveGuides.filter((g: any) => g.slug !== article.slug);
const sameKind = others.filter((g: any) => articleKind(g.slug) === kind);
const relatedArticles = [...sameKind, ...others.filter((g: any) => !sameKind.includes(g))].slice(0, 3);

const crumbs = [
  { name: "Guides", path: "/guides/" },
  { name: article.title, path: `/guides/${article.slug}/` },
];

// Configure marked with GFM (GitHub Flavored Markdown)
marked.setOptions({
  gfm: true,
  breaks: false,
});

// Render markdown using native marked parser into styled HTML
// $$...$$ blocks are pulled out first so markdown does not mangle underscores and backslashes in formulas
const mathBlocks: string[] = [];
const mdWithoutMath = bodyMd.replace(/\$\$([\s\S]+?)\$\$/g, (_m, formula) => {
  mathBlocks.push(formula.trim());
  return `

MATHBLOCK${mathBlocks.length - 1}END

`;
});
let rawHtml = marked.parse(mdWithoutMath) as string;

// Links to guides that are not published yet would 404: keep the anchor text, drop the link
rawHtml = rawHtml.replace(/<a href="\/guides\/([a-z0-9-]+)\/?">([\s\S]*?)<\/a>/g, (match, linkSlug, text) =>
  liveSlugs.has(linkSlug) ? match : text,
);

// Typeset each formula with KaTeX at build time (no client-side script)
rawHtml = rawHtml.replace(/<p>MATHBLOCK(\d+)END<\/p>/g, (_m, i) => {
  const html = katex.renderToString(mathBlocks[Number(i)].replace(/(?<!\\)%/g, "\\%"), { displayMode: true, throwOnError: false, strict: "ignore" });
  return `<div class="my-6 px-4 py-4 bg-stone-50 border border-stone-200 rounded-xl overflow-x-auto text-slate-900">${html}</div>`;
});

// Wrap markdown tables in responsive container for mobile/tablet horizontal scroll
rawHtml = rawHtml.replace(/<table>([\s\S]*?)<\/table>/g, (match) => {
  return `<div class="table-responsive-wrapper">${match}</div>`;
});

// Format inline single-dollar math or formulas
rawHtml = rawHtml.replace(/\\\$/g, "$");

// Add anchor IDs to H2 tags for Table of Contents jump links
rawHtml = rawHtml.replace(/<h2>(.*?)<\/h2>/g, (match, title) => {
  const cleanTitle = title.replace(/<[^>]+>/g, "").trim();
  const slug = cleanTitle.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
  return `<h2 id="${slug}">${title}</h2>`;
});

// Extract Table of Contents from h2 headers
const tocMatches = [...bodyMd.matchAll(/^##\s+(.*$)/gm)];
const toc = tocMatches.map((m) => {
  const text = m[1].replace(/[*_`]/g, "").trim();
  const id = text.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
  return { text, id };
});

const schema = [
  articleSchema({
    title: article.title,
    description: article.description,
    path: `/guides/${article.slug}/`,
    published: new Date(article.published_at),
    updated: article.content_updated_at ? new Date(article.content_updated_at) : undefined,
  }),
  breadcrumbSchema(crumbs),
];
---

<Base
  title={article.title}
  description={article.description}
  schema={schema}
  crumbs={crumbs}
  ogImage={`/og/${article.slug}.png`}
  published={new Date(article.published_at)}
  updated={article.content_updated_at ? new Date(article.content_updated_at) : undefined}
>
  {kind === "editorial" && (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
      <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-slate-900">Home</a><span>/</span>
        <a href="/guides/" class="hover:text-slate-900">Guides</a>
      </nav>
      <div class="h-44 sm:h-60 lg:h-72 rounded-3xl overflow-hidden border border-stone-200 shadow-sm" set:html={cover} />
      <header class="max-w-3xl mt-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-brand-700">{kindLabel}</p>
        <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-900 leading-[1.1]">{article.title}</h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed font-serif italic">{article.description}</p>
        <p class="mt-5 text-xs text-slate-500 font-mono">
          <time datetime={article.published_at}>{article.published_at?.slice(0, 10)}</time> &middot; {minutes} min read &middot; Reviewed by Eren Şimşir
        </p>
      </header>
      <div class="mt-10 grid lg:grid-cols-[minmax(0,1fr)_15rem] gap-10">
        <article class="guide-article guide-dropcap min-w-0 max-w-3xl" set:html={rawHtml} />
        {toc.length > 2 && (
          <aside class="hidden lg:block">
            <nav aria-label="Table of Contents" class="sticky top-24 border-l-2 border-stone-200 pl-4">
              <h2 class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 mb-3">On this page</h2>
              <ul class="space-y-2 text-xs leading-snug">
                {toc.map((item) => (<li><a href={`#${item.id}`} class="text-slate-600 hover:text-brand-800 hover:underline">{item.text}</a></li>))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </div>
  )}

  {kind === "figure" && (
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
      <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-slate-900">Home</a><span>/</span>
        <a href="/guides/" class="hover:text-slate-900">Guides</a>
      </nav>
      <header class="grid md:grid-cols-5 gap-8 items-center">
        <div class="md:col-span-3">
          <p class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-brand-700">{kindLabel}</p>
          <h1 class="mt-3 text-3xl sm:text-4xl font-serif font-bold text-slate-900 leading-tight">{article.title}</h1>
          <p class="mt-4 text-base text-slate-600 leading-relaxed">{article.description}</p>
          {headline && (
            <div class="mt-6 inline-flex items-baseline gap-3 px-5 py-3 rounded-2xl bg-brand-950 text-white">
              <span class="text-3xl font-serif font-bold tracking-tight">{headline}</span>
              <span class="text-[11px] font-mono uppercase tracking-wider text-brand-300">headline figure</span>
            </div>
          )}
          <p class="mt-5 text-xs text-slate-500 font-mono">
            <time datetime={article.published_at}>{article.published_at?.slice(0, 10)}</time> &middot; {minutes} min read &middot; Reviewed by Eren Şimşir
          </p>
        </div>
        <div class="md:col-span-2 aspect-[960/420] rounded-3xl overflow-hidden border border-stone-200 shadow-sm" set:html={cover} />
      </header>
      {toc.length > 2 && (
        <nav aria-label="Table of Contents" class="mt-8 flex flex-wrap gap-2">
          {toc.map((item) => (<a href={`#${item.id}`} class="px-3 py-1.5 rounded-full bg-white border border-stone-200 text-xs text-slate-700 hover:border-brand-600 hover:text-brand-800 transition-colors">{item.text}</a>))}
        </nav>
      )}
      <article class="guide-article mt-10 bg-white rounded-2xl border border-stone-200 p-6 sm:p-10 shadow-sm" set:html={rawHtml} />
    </div>
  )}

  {kind === "ledger" && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
      <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-slate-900">Home</a><span>/</span>
        <a href="/guides/" class="hover:text-slate-900">Guides</a>
      </nav>
      <header class="relative overflow-hidden rounded-3xl bg-brand-950 text-white">
        <div class="h-32 sm:h-40" set:html={cover} />
        <div class="p-8 sm:p-12">
          <p class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-brand-300">{kindLabel}</p>
          <h1 class="mt-3 max-w-2xl text-3xl sm:text-4xl font-serif font-bold leading-tight text-white">{article.title}</h1>
          <p class="mt-4 max-w-xl text-sm sm:text-base text-brand-100 leading-relaxed">{article.description}</p>
          <p class="mt-6 text-xs text-brand-300 font-mono">
            <time datetime={article.published_at}>{article.published_at?.slice(0, 10)}</time> &middot; {minutes} min read &middot; Reviewed by Eren Şimşir
          </p>
        </div>
      </header>
      {toc.length > 2 && (
        <nav aria-label="Table of Contents" class="mt-8">
          <h2 class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 mb-3">Step by step</h2>
          <ol class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm">
            {toc.map((item, i) => (
              <li class="flex gap-3 items-baseline">
                <span class="font-mono text-xs text-brand-600 w-5 shrink-0">{String(i + 1).padStart(2, "0")}</span>
                <a href={`#${item.id}`} class="text-slate-800 hover:text-brand-800 hover:underline">{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <article class="guide-article guide-ledger mt-10 min-w-0" set:html={rawHtml} />
    </div>
  )}

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <section class="p-6 bg-stone-50 border border-stone-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center gap-5">
      <div class="w-14 h-14 rounded-full bg-slate-900 text-white font-serif font-bold text-xl flex items-center justify-center shrink-0">ES</div>
      <div>
        <h3 class="text-sm font-serif font-bold text-slate-900">Written and audited by Eren Şimşir</h3>
        <p class="text-xs text-slate-500 mt-0.5 font-mono">Systems Engineer &amp; Compensation Analyst</p>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Figures reference Title 29 (FLSA), the Internal Revenue Code and IRS Publication 15-T for 2026. See the <a href="/methodology/" class="text-brand-700 underline font-medium">methodology</a> and <a href="/editorial-policy/" class="text-brand-700 underline font-medium">editorial policy</a>. This article is general information, not legal or tax advice.
        </p>
      </div>
    </section>

    {relatedArticles.length > 0 && (
      <section class="mt-12 pt-8 border-t border-stone-200">
        <div class="flex items-baseline justify-between mb-6">
          <h3 class="text-xl font-serif font-bold text-slate-900">Keep reading</h3>
          <a href="/guides/" class="text-xs font-semibold text-slate-900 hover:underline">All {liveGuides.length} guides &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {relatedArticles.map((rel: any) => (
            <a href={`/guides/${rel.slug}/`} class="group block bg-white border border-stone-200 rounded-xl overflow-hidden hover:border-slate-400 hover:shadow-sm transition-all">
              <div class="h-24" set:html={coverSvg(rel.slug, articleKind(rel.slug), { className: "w-full h-full" })} />
              <div class="p-4">
                <h4 class="text-sm font-serif font-bold text-slate-900 group-hover:text-brand-700 leading-snug">{rel.title}</h4>
                <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">{rel.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
