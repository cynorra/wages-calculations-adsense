---
import Base from "../../layouts/Base.astro";
import { localRows, liveArticles } from "../../lib/articles-source.js";
import { guideRow } from "../../lib/frontmatter.js";
import { articleSchema, breadcrumbSchema } from "../../lib/schema.js";
import { TOOLS } from "../../lib/tools.js";
import { marked } from "marked";

export async function getStaticPaths() {
  const guideFiles = import.meta.glob<{ default: string }>("../../content/guides/*.md", { query: "?raw", import: "default", eager: true });
  const entries = Object.entries(guideFiles).map(([path, content]) => {
    const filename = path.split("/").pop() || "";
    return guideRow(filename, content);
  });

  return entries.map((article: any) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const relatedTool = TOOLS.find((t) => t.guideSlug === article.slug || t.slug === article.tool);

// Get related articles for internal PageRank linking (same cluster or nearby topics)
const allGuides = localRows();
const relatedArticles = allGuides
  .filter((g: any) => g.slug !== article.slug)
  .slice(0, 3);

const crumbs = [
  { name: "Guides", path: "/guides/" },
  { name: article.title, path: `/guides/${article.slug}/` },
];

// Configure marked with GFM (GitHub Flavored Markdown)
marked.setOptions({
  gfm: true,
  breaks: false,
});

// Render markdown using native marked parser into styled HTML
let rawHtml = marked.parse(article.body_md);

// Format standalone math equation blocks ($$...$$) into styled callout blocks
rawHtml = rawHtml.replace(/<p>\$\$([\s\S]*?)\$\$<\/p>/g, (match, formula) => {
  return `<div class="my-5 p-4 bg-stone-100 border-l-4 border-slate-700 rounded-r-lg font-mono text-xs sm:text-sm text-slate-900 overflow-x-auto shadow-sm">${formula.trim()}</div>`;
});

// Format inline single-dollar math or formulas
rawHtml = rawHtml.replace(/\\\$/g, "$");

// Add anchor IDs to H2 tags for Table of Contents jump links
rawHtml = rawHtml.replace(/<h2>(.*?)<\/h2>/g, (match, title) => {
  const cleanTitle = title.replace(/<[^>]+>/g, "").trim();
  const slug = cleanTitle.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
  return `<h2 id="${slug}">${title}</h2>`;
});

// Extract Table of Contents from h2 headers
const tocMatches = [...article.body_md.matchAll(/^##\s+(.*$)/gm)];
const toc = tocMatches.map((m) => {
  const text = m[1].replace(/[*_`]/g, "").trim();
  const id = text.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
  return { text, id };
});

const schema = [
  articleSchema({
    title: article.title,
    description: article.description,
    path: `/guides/${article.slug}/`,
    published: new Date(article.published_at),
    updated: article.content_updated_at ? new Date(article.content_updated_at) : undefined,
  }),
  breadcrumbSchema(crumbs),
];
---

<Base
  title={article.title}
  description={article.description}
  schema={schema}
  crumbs={crumbs}
  published={new Date(article.published_at)}
  updated={article.content_updated_at ? new Date(article.content_updated_at) : undefined}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <!-- Breadcrumb Display -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-slate-500 font-mono">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/guides/" class="hover:text-slate-900">Guides</a>
      <span>/</span>
      <span class="text-slate-900 truncate max-w-[240px] sm:max-w-none">{article.title}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8 pb-6 border-b border-stone-200">
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-4 font-mono">
        <span class="px-2 py-0.5 bg-stone-100 text-stone-800 rounded font-semibold uppercase tracking-wider text-[11px]">Editorial Guide</span>
        <span>&bull;</span>
        <time datetime={article.published_at}>{article.published_at?.slice(0, 10)}</time>
        <span>&bull;</span>
        <span>Reading Time: ~6 min</span>
        <span>&bull;</span>
        <span class="text-brand-800 font-sans font-semibold">Reviewed by Eren Şimşir, Systems Engineer</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-900 tracking-tight leading-tight">
        {article.title}
      </h1>

      <p class="mt-4 text-lg text-slate-600 leading-relaxed font-serif italic">
        {article.description}
      </p>

      <!-- Editorial Transparency Badge (E-E-A-T AdSense Compliance) -->
      <div class="mt-6 p-4 bg-stone-50 border border-stone-200 rounded-xl flex items-start gap-3 text-xs text-slate-600">
        <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <div class="leading-relaxed">
          <strong class="font-semibold text-slate-900">Statutory Accuracy & Editorial Disclosure:</strong> This analysis references official US federal statutes (Title 29 Fair Labor Standards Act, Title 26 Internal Revenue Code) and state labor codes. Figures reflect 2026 tax brackets and standard deductions under IRS Publication 15-T. Reviewed under our <a href="/editorial-policy/" class="text-brand-700 underline font-medium">Editorial Verification Standards</a>.
        </div>
      </div>
    </header>

    <!-- Interactive Tool Callout -->
    {relatedTool && (
      <aside aria-label="Companion Calculator" class="mb-10 p-5 bg-gradient-to-r from-stone-50 to-brand-50/40 border border-stone-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-brand-800 uppercase tracking-wider font-mono">Companion Interactive Engine</span>
          <h2 class="text-base font-serif font-bold text-slate-900 mt-0.5">{relatedTool.name}</h2>
          <p class="text-xs text-slate-600 mt-0.5">{relatedTool.blurb}</p>
        </div>
        <a
          href={relatedTool.href}
          class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold whitespace-nowrap shadow-sm transition-colors flex items-center gap-1.5"
        >
          <span>Calculate Now</span>
          <span>&rarr;</span>
        </a>
      </aside>
    )}

    <!-- Table of Contents (AEO / GEO Navigation) -->
    {toc.length > 2 && (
      <nav aria-label="Table of Contents" class="mb-10 p-5 bg-stone-50/80 rounded-2xl border border-stone-200">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 font-mono">In This Article</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          {toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="text-brand-800 hover:text-slate-900 hover:underline flex items-baseline gap-1.5 py-0.5">
                <span class="text-slate-400">&bull;</span>
                <span class="truncate">{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Main Article Body Content with Rich .guide-article Styling -->
    <article class="bg-white rounded-2xl border border-stone-200 p-6 sm:p-10 lg:p-12 shadow-sm text-slate-800 leading-relaxed font-sans">
      <div class="guide-article" set:html={rawHtml} />
    </article>

    <!-- Author & Trust Signature (E-E-A-T AdSense Requirement) -->
    <section class="mt-10 p-6 bg-stone-50 border border-stone-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center gap-5">
      <div class="w-14 h-14 rounded-full bg-slate-900 text-white font-serif font-bold text-xl flex items-center justify-center shrink-0 shadow-sm">
        ES
      </div>
      <div>
        <h3 class="text-sm font-serif font-bold text-slate-900">Written and Audited by Eren Şimşir</h3>
        <p class="text-xs text-slate-500 mt-0.5 font-mono">Systems Engineer & Compensation Analyst &bull; Founder of HourlySalaryReport</p>
        <p class="text-xs text-slate-600 mt-2 leading-relaxed">
          Specializes in enterprise payroll algorithm architecture, FLSA overtime modeling, and progressive tax mathematics. Read our full <a href="/methodology/" class="text-brand-700 underline font-medium">Methodology & Mathematical Standards</a>.
        </p>
      </div>
    </section>

    <!-- Contextual Internal Authority Linking (PageRank Architecture) -->
    {relatedArticles.length > 0 && (
      <section class="mt-12 pt-8 border-t border-stone-200">
        <div class="flex items-baseline justify-between mb-6">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 font-mono">Related Research & Legal Analysis</span>
            <h3 class="text-xl font-serif font-bold text-slate-900 mt-1">Recommended Guides & Statutory Standards</h3>
          </div>
          <a href="/guides/" class="text-xs font-semibold text-slate-900 hover:underline">
            All 25 Guides &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {relatedArticles.map((rel: any) => (
            <article class="p-5 bg-white border border-stone-200 rounded-xl hover:border-slate-400 hover:shadow-sm transition-all flex flex-col justify-between group">
              <div>
                <span class="text-[10px] font-mono text-slate-400 block mb-2">{rel.published_at?.slice(0, 10)}</span>
                <h4 class="text-sm font-serif font-bold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
                  <a href={`/guides/${rel.slug}/`}>
                    {rel.title}
                  </a>
                </h4>
                <p class="text-xs text-slate-500 mt-2.5 line-clamp-2 leading-relaxed font-sans">
                  {rel.description}
                </p>
              </div>
              <a
                href={`/guides/${rel.slug}/`}
                class="mt-4 pt-3 border-t border-stone-100 text-xs font-medium text-slate-900 group-hover:underline inline-flex items-center gap-1 font-mono"
              >
                <span>Read Analysis</span>
                <span>&rarr;</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Browse Directory Banner -->
    <div class="mt-10 p-6 bg-stone-100/70 rounded-2xl border border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h4 class="text-sm font-serif font-bold text-slate-900">Need specific paycheck calculations?</h4>
        <p class="text-xs text-slate-600 mt-0.5">Explore our companion directory of 25 open-formula FLSA compensation calculators.</p>
      </div>
      <a href="/calculators/" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold uppercase tracking-wider transition-colors shrink-0 shadow-sm">
        Browse Calculators &rarr;
      </a>
    </div>
  </div>
</Base>
