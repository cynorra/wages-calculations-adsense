---
import Base from "../../layouts/Base.astro";
import { liveArticles } from "../../lib/articles-source.js";
import { breadcrumbSchema } from "../../lib/schema.js";
import { articleKind, KIND_LABEL } from "../../lib/article-kind.js";
import { coverSvg } from "../../lib/cover-art.js";

const articles = await liveArticles();
const crumbs = [{ name: "Payroll Guides", path: "/guides/" }];
const schema = [breadcrumbSchema(crumbs)];
---

<Base
  title="Payroll Guides & FLSA Wage Analysis"
  description="In-depth technical guides explaining overtime formulas, Fair Labor Standards Act provisions, IRS withholding calculations, and statutory labor laws."
  schema={schema}
  crumbs={crumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="max-w-3xl mb-12">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 mb-3">
        Technical Knowledge Base
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Payroll Guides & Technical Articles
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Engineered for workers, independent contractors, and payroll accountants seeking transparent, open-formula explanations of statutory wage mechanics.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((guide: any) => (
        <article class="bg-white rounded-2xl border border-slate-200 p-6 overflow-hidden shadow-sm hover:border-brand-500 hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <a href={`/guides/${guide.slug}/`} class="block -mx-6 -mt-6 mb-5 aspect-[960/420]" aria-label={guide.title} set:html={coverSvg(guide.slug, articleKind(guide.slug), { className: "w-full h-full" })} />
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="font-mono">{guide.published_at?.slice(0, 10)}</span>
              <span class="font-semibold text-brand-700 uppercase bg-brand-50 px-2 py-0.5 rounded text-[10px]">{KIND_LABEL[articleKind(guide.slug)]}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
              <a href={`/guides/${guide.slug}/`}>
                {guide.title}
              </a>
            </h2>
            <p class="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed">
              {guide.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <a href={`/guides/${guide.slug}/`} class="text-xs font-semibold text-brand-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
              Read Guide &rarr;
            </a>
            <span class="text-[11px] text-slate-400">By Eren Şimşir</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
