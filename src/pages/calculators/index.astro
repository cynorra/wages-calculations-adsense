---
import Base from "../../layouts/Base.astro";
import { TOOLS } from "../../lib/tools.js";
import { breadcrumbSchema } from "../../lib/schema.js";

const crumbs = [{ name: "Calculators", path: "/calculators/" }];

const clusters = [
  { id: 1, name: "Core Converters & Annual Matrices" },
  { id: 2, name: "Net Pay & Payroll Deductions" },
  { id: 3, name: "Overtime & Shift Mathematics" },
  { id: 4, name: "Specialized Payroll & E-E-A-T Scenarios" },
  { id: 5, name: "State Comparison & Purchasing Power" },
];

const schema = [breadcrumbSchema(crumbs)];
---

<Base
  title="All 25 Wage, Paycheck & Salary Calculators"
  description="Explore our complete suite of 25 interactive wage calculators covering hourly to salary conversions, FLSA overtime multipliers, W-4 tax models, and 50-state minimum wage benchmarks."
  schema={schema}
  crumbs={crumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="max-w-3xl mb-12">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 mb-3">
        Comprehensive Financial Directory
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        All Wage & Paycheck Calculators
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Every tool is built with strict adherence to the Fair Labor Standards Act (FLSA), IRS Form W-4 withholding rules, and 2026 state-level tax structures. Select a calculator below to get started.
      </p>
    </div>

    <div class="space-y-12">
      {clusters.map((c) => {
        const clusterTools = TOOLS.filter((t) => t.cluster === c.id);
        return (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
              <div>
                <span class="text-xs font-bold text-brand-700 uppercase tracking-wider">Cluster {c.id}</span>
                <h2 class="text-xl font-bold text-slate-900 mt-0.5">{c.name}</h2>
              </div>
              <span class="text-xs px-2.5 py-1 bg-slate-100 rounded-full font-semibold text-slate-600">
                {clusterTools.length} Tools
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {clusterTools.map((t) => (
                <a
                  href={t.href}
                  class="p-5 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-brand-500 hover:shadow-md transition-all group flex flex-col justify-between"
                >
                  <div>
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                      {t.name}
                    </h3>
                    <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                      {t.description}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-brand-600 group-hover:translate-x-0.5 transition-transform">
                      Open Calculator &rarr;
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono">2,080h</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Base>
