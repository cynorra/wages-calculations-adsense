---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.config.js";
import { breadcrumbSchema } from "../lib/schema.js";

const crumbs = [{ name: "Privacy Policy", path: "/privacy/" }];
const schema = [breadcrumbSchema(crumbs)];
---

<Base
  title="Privacy Policy"
  description={`Privacy Policy for ${SITE.name}. Learn how we protect your information and uphold zero-storage client-side calculation principles.`}
  schema={schema}
  crumbs={crumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 shadow-sm prose prose-slate max-w-none text-sm text-slate-700 leading-relaxed">
      <h1 class="text-3xl font-extrabold text-slate-900 not-prose">Privacy Policy</h1>
      <p class="text-xs text-slate-500">Effective Date: January 1, 2026 | Last Updated: October 2026</p>

      <hr class="my-6" />

      <h2>1. Fundamental Zero-Data Principle</h2>
      <p>
        <strong>We do not collect, store, or transmit your financial inputs.</strong> Every calculation performed on {SITE.name}—including hourly rates, annual salaries, tax filing statuses, and overtime hours—is executed exclusively inside your local web browser via client-side JavaScript.
      </p>

      <h2>2. Information Automatically Collected</h2>
      <p>
        Like most websites, our hosting platform (Cloudflare Pages) records standard web server logs (such as IP addresses, browser types, referring pages, and access timestamps) for security diagnostics, DDoS mitigation, and server performance monitoring.
      </p>

      <h2>3. Advertising & Cookies</h2>
      <p>
        Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites. Google's use of advertising cookies enables it and its partners to serve ads to users based on their visit to our sites and/or other sites on the Internet.
      </p>
      <p>
        Users may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> or <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer">AboutAds.info</a>.
      </p>

      <h2>4. Contact Information</h2>
      <p>
        For inquiries regarding this privacy statement, please email our administrative team at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</Base>
