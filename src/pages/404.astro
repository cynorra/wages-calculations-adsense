---
import Base from "../layouts/Base.astro";
import { NAV } from "../site.config.js";

const title = "Page Not Found (404)";
const description = "The paycheck calculator or compensation guide you requested could not be located. Browse our directory of tools and research guides.";
---

<Base title={title} description={description} noindex={true}>
  <div class="max-w-3xl mx-auto px-4 py-20 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-stone-100 text-slate-800 font-mono text-2xl font-bold mb-6">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-slate-900 tracking-tight">
      Compensation Record Not Found
    </h1>
    <p class="mt-4 text-base text-slate-600 max-w-lg mx-auto leading-relaxed">
      The specific calculation route or statutory guide you requested has either moved or is not yet published under our release schedule.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="px-5 py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm"
      >
        Return to Home
      </a>
      <a
        href="/calculators/"
        class="px-5 py-3 bg-stone-100 hover:bg-stone-200 text-slate-800 rounded-xl text-xs font-semibold uppercase tracking-wider transition-colors"
      >
        Browse Calculators
      </a>
      <a
        href="/guides/"
        class="px-5 py-3 bg-stone-100 hover:bg-stone-200 text-slate-800 rounded-xl text-xs font-semibold uppercase tracking-wider transition-colors"
      >
        All Editorial Guides
      </a>
    </div>
  </div>
</Base>
