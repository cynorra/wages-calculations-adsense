---
import { SITE, NAV } from "../site.config.js";

const { crumbs } = Astro.props;
const pathname = Astro.url.pathname;
---
<header class="bg-white border-b border-slate-200/80 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Minimalist Editorial Logo -->
      <a href="/" class="flex items-baseline gap-2 group">
        <span class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 group-hover:text-brand-700 transition-colors">
          TheWage<span class="italic font-normal text-slate-500 text-xl sm:text-2xl ml-0.5">Report</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {NAV.map((item) => {
          const active = pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-sm tracking-tight transition-colors rounded-md ${
                active
                  ? "text-slate-900 font-semibold bg-slate-100"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-50"
              }`}
            >
              {item.label}
            </a>
          );
        })}
        <div class="pl-3 ml-2 border-l border-slate-200">
          <a
            href="/guides/"
            class="inline-flex items-center px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-slate-900 hover:bg-slate-800 rounded-md transition-colors"
          >
            All Articles
          </a>
        </div>
      </nav>

      <!-- Mobile Menu Toggle Button -->
      <div class="md:hidden flex items-center gap-2">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
          class="p-2 rounded-md text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        >
          <svg id="menu-open-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Collapsible Menu Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white shadow-lg px-4 pt-3 pb-6 space-y-1">
    {NAV.map((item) => {
      const active = pathname.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            active
              ? "bg-slate-100 text-brand-700 font-semibold"
              : "text-slate-700 hover:bg-slate-50 hover:text-slate-900"
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100">
      <a
        href="/guides/"
        class="block w-full text-center px-4 py-2.5 text-sm font-semibold rounded-lg text-white bg-brand-600 hover:bg-brand-700 shadow-sm"
      >
        Explore All Articles & Research
      </a>
    </div>
  </div>

  <script is:inline>
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!isExpanded));
        menu.classList.toggle("hidden");
        openIcon?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
      });
    }
  </script>

  {crumbs && crumbs.length > 0 && (
    <div class="bg-slate-50 border-t border-slate-100 text-xs text-slate-500 py-2">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1.5 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-slate-900">Home</a>
        {crumbs.map((c: any, i: number) => (
          <span class="flex items-center gap-1.5">
            <span class="text-slate-400">/</span>
            {i === crumbs.length - 1 ? (
              <span class="text-slate-800 font-medium">{c.name}</span>
            ) : (
              <a href={c.path} class="hover:text-slate-900">{c.name}</a>
            )}
          </span>
        ))}
      </div>
    </div>
  )}
</header>
