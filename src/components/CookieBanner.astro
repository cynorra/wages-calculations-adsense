---
import { SITE } from "../site.config.js";
---
<div
  id="cookie-consent-banner"
  hidden
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-50"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and privacy choices"
>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl text-slate-800">
    <h3 class="font-bold text-sm text-slate-900 mb-1">Privacy and cookie choices</h3>
    <p class="text-xs text-slate-600 leading-relaxed">
      {SITE.name} uses Google AdSense to show ads, which can set cookies for personalized advertising. Ads and their cookies load only if you accept. The calculators and articles work either way. See the <a href="/privacy/#cookies" class="underline text-brand-700">privacy policy</a>.
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button id="cookie-consent-accept" type="button" class="px-4 py-2 rounded-lg bg-slate-900 text-white font-semibold text-xs hover:bg-slate-700 transition-colors cursor-pointer">Accept</button>
      <button id="cookie-consent-reject" type="button" class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-800 font-semibold text-xs hover:bg-slate-50 transition-colors cursor-pointer">Reject</button>
      <a href="/privacy/#cookies" class="px-3 py-2 text-slate-600 hover:text-slate-900 font-medium text-xs hover:underline">Manage choices</a>
    </div>
  </div>
</div>

<script is:inline>
  // Hidden in the HTML (no flash); shown only when no choice is stored.
  // "thewagereport_consent_accepted": "true" = accepted, "false" = rejected.
  (function () {
    var KEY = "thewagereport_consent_accepted";
    var banner = document.getElementById("cookie-consent-banner");
    if (!banner) return;
    function stored() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function choose(value) {
      try { localStorage.setItem(KEY, value ? "true" : "false"); } catch (e) {}
      banner.hidden = true;
      window.dispatchEvent(new CustomEvent("thewagereport:consent", { detail: value ? "accepted" : "rejected" }));
    }
    if (stored() === null) banner.hidden = false;
    document.getElementById("cookie-consent-accept").addEventListener("click", function () { choose(true); });
    document.getElementById("cookie-consent-reject").addEventListener("click", function () { choose(false); });
    window.addEventListener("thewagereport:reopen-consent", function () { banner.hidden = false; });
  })();
</script>
