---
import { SITE, AUTHOR, NAV } from "../site.config.js";
import { TOOLS } from "../lib/tools.js";

const currentYear = new Date().getFullYear();
---
<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: About & Author -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-baseline gap-1 group">
          <span class="font-serif text-2xl font-bold tracking-tight text-white">
            HourlySalary<span class="italic font-normal text-slate-400 text-xl ml-0.5">Report</span>
          </span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed font-normal">
          An independent workplace economics publication breaking down federal labor statutes, payroll withholdings, and compensation arithmetic.
        </p>
        <div class="text-xs text-slate-400 pt-2 border-t border-slate-800">
          <p class="font-medium text-slate-300">Edited by <a href={`/author/${AUTHOR.slug}/`} class="text-white hover:underline">{AUTHOR.name}</a></p>
          <p class="text-slate-500">{AUTHOR.role}</p>
        </div>
      </div>

      <!-- Col 2: Core Calculators -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-4">Core Calculators</h3>
        <ul class="space-y-2 text-xs">
          {TOOLS.slice(0, 6).map((t) => (
            <li>
              <a href={t.href} class="text-slate-400 hover:text-white transition-colors">
                {t.shortName}
              </a>
            </li>
          ))}
          <li>
            <a href="/calculators/" class="text-brand-400 hover:text-brand-300 font-medium">
              View All 25 Calculators &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Overtime & Taxes -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-4">Specialized Audits</h3>
        <ul class="space-y-2 text-xs">
          {TOOLS.slice(12, 18).map((t) => (
            <li>
              <a href={t.href} class="text-slate-400 hover:text-white transition-colors">
                {t.shortName}
              </a>
            </li>
          ))}
          <li>
            <a href="/guides/" class="text-brand-400 hover:text-brand-300 font-medium">
              Browse Technical Guides &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Trust & Compliance -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-4">E-E-A-T & Legal</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/about/" class="text-slate-400 hover:text-white transition-colors">About & Editorial Team</a></li>
          <li><a href="/methodology/" class="text-slate-400 hover:text-white transition-colors">Mathematical Methodology & FLSA Standards</a></li>
          <li><a href="/editorial-policy/" class="text-slate-400 hover:text-white transition-colors">Editorial & Verification Policy</a></li>
          <li><a href="/privacy/" class="text-slate-400 hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-slate-400 hover:text-white transition-colors">Terms of Use</a></li>
          <li><a href="/disclaimer/" class="text-slate-400 hover:text-white transition-colors">Financial Disclaimer</a></li>
          <li><a href="/contact/" class="text-slate-400 hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p>&copy; {currentYear} {SITE.name}. All formulas derived from Title 29 of the US Code and IRS Publication 15-T.</p>
      <div class="flex items-center space-x-4">
        <a href="/rss.xml" class="text-slate-400 hover:text-slate-300">RSS Feed</a>
        <a href="/llms.txt" class="text-slate-400 hover:text-slate-300">llms.txt</a>
        <a href="/robots.txt" class="text-slate-400 hover:text-slate-300">robots.txt</a>
        <a href="/sitemap-index.xml" class="text-slate-400 hover:text-slate-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
